# Copy to .env.local and fill in real values before deploying anywhere
# beyond local development. .env.local (runtime) and .env (Prisma CLI) are
# both gitignored — never commit real secrets here.

# --- Required for the app to run at all ---

# Auth.js (next-auth) session token signing/encryption. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string. In development, .env.local should use a
# restricted `app_user` role (see prisma/grants.sql — least privilege,
# append-only on audit_logs); .env (separate, Prisma-CLI-only) uses a
# superuser connection for migrations. In production this should be a
# managed Postgres instance's connection string with the same app_user-style
# restricted grants applied via prisma/grants.sql before first deploy.
DATABASE_URL=

# Canonical production domain, used by sitemap.xml/robots.txt/metadataBase
# (Phase 14). Defaults to an explicit placeholder if unset — the site will
# still run, but sitemap/canonical URLs will be wrong until this is set.
NEXT_PUBLIC_SITE_URL=

# --- Required only for specific hosting setups ---

# Auth.js v5 needs this set to "true" when self-hosting behind a reverse
# proxy that doesn't set trusted forwarded-host headers the way Vercel does.
# Not needed on Vercel; needed for `next start` behind e.g. Nginx/Docker.
AUTH_TRUST_HOST=

# --- Not yet wired up (Phase 13 Milestone 15 — Payments — deferred) ---
# Real Stripe integration needs these; no credentials available in the
# environment this project was built in. See PROGRESS.md Milestone 15.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Not yet wired up (email delivery — vendor TBD per Phase 11) ---
# Notifications (Milestone 14) currently log what would be emailed instead
# of sending it, since no provider is configured. Once a vendor is chosen:
# RESEND_API_KEY=
