# Copy to .env.local and fill in real values before deploying anywhere
# beyond local development. .env.local is gitignored.

# Required by Auth.js (next-auth) to sign/encrypt session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Milestone 11+ (real database) and later milestones will add:
# DATABASE_URL=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# S3/R2 storage credentials
# per the Phase 11 architecture doc — vendor choices still pending confirmation.
