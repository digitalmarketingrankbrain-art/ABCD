# Copy to .env and fill in real values.

# Postgres connection string (least-privilege app_user role — see grants.sql).
DATABASE_URL=

# Must match frontend/.env.local's AUTH_SECRET exactly — the backend decodes
# the same NextAuth-issued JWT the frontend sends as a bearer token.
AUTH_SECRET=

PORT=4001

# Shared secret for the two pre-session auth endpoints (request-otp,
# verify-otp) that have no user JWT to check yet. Must match frontend's
# INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=
