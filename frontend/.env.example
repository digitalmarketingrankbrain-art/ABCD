# Copy to .env.local and fill in real values.

# Auth.js (next-auth) session token signing/encryption. Must match
# backend/.env's AUTH_SECRET exactly.
AUTH_SECRET=

# Where the backend API is reachable from the frontend's Node process
# (server-only — the browser never calls this directly).
BACKEND_URL=http://localhost:4001

# Must match backend/.env's INTERNAL_API_KEY exactly.
INTERNAL_API_KEY=

NEXT_PUBLIC_SITE_URL=
AUTH_TRUST_HOST=
